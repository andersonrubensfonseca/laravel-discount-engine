{
    "name": "solutionsti/laravel-discount-engine",
    "description": "Motor de descontos orientado a regras para carrinhos: cupons, regras automaticas, condicoes compostas e acoes combinaveis.",
    "keywords": ["laravel", "discount", "coupon", "promotion", "cart", "rules-engine", "ecommerce"],
    "license": "MIT",
    "authors": [
        {
            "name": "Anderson Rubens Fonseca",
            "email": "anderson@solutionsti.com.br"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "suggest": {
        "illuminate/support": "Necessario apenas para a camada de integracao Laravel (^8.75 || ^13.0)."
    },
    "autoload": {
        "psr-4": {
            "SolutionsTI\\DiscountEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionsTI\\DiscountEngine\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
